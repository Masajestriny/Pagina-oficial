# ==============================================================================
# TRINY MASAJES - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Instrucciones: Copiar este archivo como .env y asignar los valores reales del entorno.
# NUNCA subir el archivo .env a GitHub o sistemas de control de versiones.
# ==============================================================================

# Entorno de ejecución y servidor
NODE_ENV=development
PORT=3000

# Seguridad de Sesión del CRM (Generar clave aleatoria de 32+ caracteres)
SESSION_SECRET=

# Credenciales de Acceso al Panel Administrativo CRM
CRM_ADMIN_USERNAME=admin_triny
CRM_ADMIN_PASSWORD=

# Webhook 1: Notificación de Reservas Confirmadas (Opcional)
WEBHOOK_BOOKINGS_URL=
WEBHOOK_BOOKINGS_SECRET=

# Webhook 2: Notificación de Consultas de Atención al Cliente (Opcional)
WEBHOOK_CONTACT_URL=
WEBHOOK_CONTACT_SECRET=

# Configuración Comercial del Negocio
WHATSAPP_NUMBER=51986100444
SUPPORT_EMAIL=soporte@trinymasajes.com
