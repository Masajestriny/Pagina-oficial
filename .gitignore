# ==============================================================================
# TRINY MASAJES - .gitignore PROFESIONAL
# Protección estricta de credenciales, dependencias y datos del sistema
# ==============================================================================

# Variables de entorno y secretos
.env
.env.*
!.env.example
!.env.sample

# Claves, certificados y almacenes criptográficos
*.pem
*.key
*.p12
*.pfx
*.keystore
*.crt
*.cer

# Dependencias de paquetes
node_modules/
package-lock.json.bak

# Salidas de compilación y distribución
dist/
build/
coverage/
.nyc_output/

# Registros de ejecución y depuración
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos temporales y de intercambio
tmp/
temp/
*.tmp
*.swp
*.swo
*.bak
*.orig
*~

# Copias de seguridad y volcados de bases de datos
backups/
*.dump
*.sql
*.sql.gz
*.sqlite
*.db

# Configuración local de herramientas de desarrollo
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

# Credenciales y archivos de servicio locales
credentials.json
service-account*.json
secrets/
private/
